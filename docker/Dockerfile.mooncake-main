# Mooncake built from source (upstream main) in place of the mooncake-transfer-engine-cuda13==0.3.13.post1 wheel (#20).
# The builder follows Mooncake's own EFA wheel CI (.github/workflows/_build-efa-wheel.yaml): CUDA + EFA + HTTP metadata + Store.
# Examples stay on because build_wheel.sh packages transfer_engine_bench.
#   git clone https://github.com/kvcache-ai/Mooncake.git mooncake-src && git -C mooncake-src checkout <sha>
#   docker build -f docker/Dockerfile.mooncake-main --build-context mooncake=mooncake-src -t deepinfer:agentx-l3-mcmain .
ARG BASE=deepinfer:agentx-l3
FROM ${BASE} AS builder
ENV DEBIAN_FRONTEND=noninteractive
COPY --from=mooncake . /src/Mooncake
WORKDIR /src/Mooncake
RUN apt-get update -y && apt-get install -y cmake ninja-build patchelf && bash dependencies.sh -y
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64/stubs:/usr/local/lib:${LD_LIBRARY_PATH} \
    LIBRARY_PATH=/usr/local/cuda/lib64/stubs:${LIBRARY_PATH}
RUN mkdir build && cd build && cmake -G Ninja .. \
        -DCMAKE_BUILD_TYPE=Release -DUSE_CUDA=ON -DCMAKE_EXE_LINKER_FLAGS=-L/usr/local/cuda/lib64/stubs \
        -DUSE_EFA=ON -DLIBFABRIC_INCLUDE_DIR=/opt/amazon/efa/include -DLIBFABRIC_LIBRARY=/opt/amazon/efa/lib/libfabric.so \
        -DUSE_HTTP=ON -DWITH_STORE=ON -DWITH_STORE_RUST=OFF -DWITH_METRICS=ON \
        -DBUILD_UNIT_TESTS=OFF -DBUILD_BENCHMARK=OFF \
    && cmake --build . -j 64 && cmake --install .
RUN /opt/venv/bin/pip install build wheel auditwheel setuptools \
    && PATH=/opt/venv/bin:$PATH PYTHON_VERSION=3.12 OUTPUT_DIR=/dist bash scripts/build_wheel.sh

FROM ${BASE}
COPY --from=builder /dist /tmp/mc-dist
RUN /opt/venv/bin/pip uninstall -y mooncake-transfer-engine-cuda13 \
    && /opt/venv/bin/pip install --no-deps /tmp/mc-dist/*.whl && rm -rf /tmp/mc-dist
