# Thin layer over deepinfer:agentx-trace: exact parallel tokenization in the OpenAI server (#17). Python-only.
#   docker build -f docker/Dockerfile.deepinfer-agentx-tok -t deepinfer:agentx-tok .
ARG BASE=deepinfer:agentx-trace
FROM ${BASE}
COPY patches/deepinfer-agentx-parallel-tokenize.patch /tmp/tok.patch
RUN cd /workspace/DeepInfer && git apply /tmp/tok.patch && rm /tmp/tok.patch
