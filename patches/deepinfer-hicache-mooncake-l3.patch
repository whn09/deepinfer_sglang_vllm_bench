+                if st_slot is not None:
+                    self.free_states.append(st_slot)
+                return
+            loaded = 0
+            for j, gi in enumerate(fetch_groups):
+                for t in range(g):
+                    page = gi * g + t
+                    slot = slots[j * g + t]
+                    h = chain.hashes[page]
+                    if page >= pick or h in self.pages:  # beyond the hit, or the host already holds this page
+                        self.free_pages.append(slot)
+                        continue
