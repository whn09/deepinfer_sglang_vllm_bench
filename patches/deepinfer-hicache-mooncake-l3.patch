+            keys.append(self.l3.group_key(hashes[(i + 1) * g - 1]))
+            ptrs.append([self.host_pages_ptr + e.slot * self.page_bytes for e in es])
+            sizes.append([self.page_bytes] * g)
+            held += es
+        for k in state_keys:
